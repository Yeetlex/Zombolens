{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZomboLens",
  "version": "0.1.1",
  "identifier": "io.github.zombolens",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Project Zomboid character status overlay",
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/Yeetlex/Zombolens",
    "publisher": "Yeetlex",
    "linux": {
      "deb": {
        "depends": [
          "libpcap0.8",
          "libcap2-bin"
        ],
        "postInstallScript": "../packaging/linux/postinst.sh"
      },
      "rpm": {
        "depends": [
          "libpcap",
          "libcap"
        ],
        "postInstallScript": "../packaging/linux/postinst.sh"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}