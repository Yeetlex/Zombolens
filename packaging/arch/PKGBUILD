# ZomboLens for Arch and derivatives. Builds from this checkout:
#   cd packaging/arch && makepkg -si
pkgname=zombolens
pkgver=0.1.1
pkgrel=1
pkgdesc="Project Zomboid character status overlay, read from the network"
arch=('x86_64')
url="https://github.com/Yeetlex/Zombolens"
license=('GPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'libpcap' 'libcap')
makedepends=('rust' 'cargo' 'nodejs' 'npm')
install=zombolens.install
options=('!lto' '!debug')

_root() { cd "$startdir/../.." && pwd; }

build() {
  cd "$(_root)"
  npm ci
  npx tauri build --no-bundle
}

package() {
  local root; root="$(_root)"
  install -Dm755 "$root/src-tauri/target/release/zombolens" "$pkgdir/usr/bin/zombolens"
  install -Dm644 "$root/src-tauri/icons/icon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/zombolens.svg"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/zombolens.desktop" <<DESKTOP
[Desktop Entry]
Name=ZomboLens
Comment=Project Zomboid character status overlay
Exec=zombolens
Icon=zombolens
Terminal=false
Type=Application
Categories=Game;Utility;
DESKTOP
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
